{
  "servers": {
    "cohort-discovery": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["${workspaceFolder}/scripts/cohort_mcp.py"],
      "cwd": "${workspaceFolder}"
    },
    "FabricIQ": {
      "type": "http",
      "url": "https://fabriciq.svc.cloud.microsoft/v1/mcp/fabriciq",
      "headers": {
        "X-Variants": "Fabric.Routing.FabricIQ.V1"
      }
    }
  }
}
