# Copy to config/settings.env (the default environment) or to config/settings.<name>.env for a named environment,
# chosen with COHORT_ENV=<name> or by writing <name> into config/.cohort-env. See docs/setup.md.
# Settings and state files are git-ignored: they describe your tenant. Never put secrets in them.

# Fabric: the tenant, the capacity (an F SKU, F4 or larger) and the workspace to create.
FABRIC_TENANT_ID=<entra-tenant-guid>
FABRIC_CAPACITY_ID=<capacity-guid>
FABRIC_WORKSPACE=MedicalCohortDemo

# Fabric items created in the workspace. The Bronze_ prefix marks raw data as it arrives from each source.
LAKEHOUSE_CLARITY=Bronze_Clarity
LAKEHOUSE_CABOODLE=Bronze_Caboodle
LAKEHOUSE_IMAGING=Bronze_ImagingArchive
LAKEHOUSE_DOCUMENTS=Bronze_ClinicalDocuments
PACS_DATABASE=Bronze_PACS
# Silver: OMOP CDM v5.4 built from Bronze. Gold: i2b2 star schema and ontology built from Silver, for cohort discovery.
LAKEHOUSE_SILVER_OMOP=Silver_OMOP
LAKEHOUSE_GOLD_I2B2=Gold_i2b2

# Stage 4: semantic models, i2b2 cohort query store and data-request workflow
SEMANTIC_MODEL_DISCOVERY=Cohort Discovery (i2b2)
SEMANTIC_MODEL_RESEARCH=Research Data (OMOP)
SEMANTIC_MODEL_REQUESTS=Cohort Requests
COHORT_REQUEST_DATABASE=Cohort_Requests
COHORT_FUNCTIONS=Cohort_Request_Actions
COHORT_REPORT_TEMPLATE=Cohort Request (template)
COHORT_REQUEST_FOLDER=Cohort requests
COHORT_DELIVERY_NOTEBOOK=Cohort_Delivery
COHORT_DELIVERY_PIPELINE=Cohort_Delivery_Pipeline

# Approval page for new data requests: rayfin (the approval app, scripts/22_approval_app.py) or powerbi (dashboard copied from COHORT_REPORT_TEMPLATE)
APPROVAL_UI=rayfin
# Workspace folder for the approval app; delivery lakehouses are created in the same folder
APPROVAL_APP_FOLDER=Cohort requests

# Optional, Stage 4e: the Discovery tab's GitHub Copilot relay in Azure Container Apps (scripts/23_discovery_chat.py).
# DISCOVERY_LOCATION is the Azure region for the resource group, the Container Apps environment and the registry
# (ideally the capacity's). DISCOVERY_REGISTRY must be globally unique (5 to 50 lowercase letters and digits).
DISCOVERY_RESOURCE_GROUP=<resource-group>
DISCOVERY_LOCATION=<azure-region>
DISCOVERY_ENVIRONMENT=cohort-discovery-env
DISCOVERY_CONTAINER_APP=cohort-discovery-chat
DISCOVERY_REGISTRY=<globally-unique-registry-name>

# Optional, Stage 6: Patient 360 (scripts/24 to 28). Its workspace folder, and the Container App of Ask's relay, which
# runs in the DISCOVERY_ environment and registry above.
PATIENT360_FOLDER=Patient 360
PATIENT360_CHAT_APP=patient360-chat
